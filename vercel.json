{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron?type=short",
      "schedule": "0 1,7,13,19 * * *"
    },
    {
      "path": "/api/cron?type=long",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/cron.py": {
      "maxDuration": 300
    }
  }
}
